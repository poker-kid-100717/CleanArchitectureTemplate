{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clean-architecture-template",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "../CleanArchitectureTemplate/src/WebUI/ClientApp/dist/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "containers": [
    {
      "class_name": "TodoApi",
      "image": "../CleanArchitectureTemplate/Dockerfile",
      "image_build_context": "../CleanArchitectureTemplate",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "TodoApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TodoApi"] }
  ],
  "observability": { "enabled": true }
}
